# ---- L1: os_base (Golden L1: tdk-saas-starter-l1:latest) ----
FROM tdk-saas-starter-l1:latest AS l1_os_base
# OS dependencies pre-installed in golden L1 image
WORKDIR /app


# ---- L1: runtime_env ----
# Shared runtime environment
ENV NODE_ENV=production
ENV BUN_INSTALL_CACHE_DIR=/cache/bun


# ---- L2: dependency_manifest ----
FROM tdk-saas-starter-l2:latest AS l2_deps_manifest
WORKDIR /app

# Cache-busting mechanism - change this value to force dependency reinstall
ARG CACHE_BUSTER=2026-06-25-v1
RUN echo "Cache buster: ${CACHE_BUSTER}"


# Copy workspace root for monorepo resolution
COPY package.json ./package.json
COPY services/billing/billing-api/.autogenerated/.npmrc.docker.autogenerated /app/.npmrc
COPY services/billing/billing-api/.autogenerated/bunfig.docker.autogenerated.toml /app/.bunfig.toml

# Copy service manifest files for deterministic dependency layer
WORKDIR /app/services/billing/billing-api
COPY services/billing/billing-api/package.json ./package.json
COPY services/billing/billing-api/.autogenerated/.npmrc.docker.autogenerated .npmrc
COPY bun.lock* ./
COPY services/billing/billing-api/.autogenerated/bunfig.docker.autogenerated.toml .bunfig.toml

# Diagnostics suppressed (set TILT_DEBUG=true for verbose output)
# Install dependencies (quiet by default; set TILT_DEBUG=true for verbose diagnostics)
COPY shared-platform-engineering/docker-templates/install-deps.sh /usr/local/bin/install-deps.sh
RUN --mount=type=cache,target=/cache/bun,sharing=shared chmod +x /usr/local/bin/install-deps.sh && start_ts=$(date +%s) && /usr/local/bin/install-deps.sh && end_ts=$(date +%s) && echo "install-deps duration: $((end_ts-start_ts))s"


# ---- L3: backend_compiler ----
FROM tdk-saas-starter-l3-backend:latest AS l3_backend_build
WORKDIR /app/services/billing/billing-api
# Build argument to skip Infisical setup (for local dev / fast builds)
ARG SKIP_INFISICAL_SETUP=0
# Reuse resolved dependencies from l2_deps_manifest to avoid reinstalling in L3
COPY --link --from=l2_deps_manifest /app/services/billing/billing-api/node_modules ./node_modules
# Bun isolated linker symlinks may resolve through /app/node_modules/.bun
COPY --link --from=l2_deps_manifest /app/node_modules/.bun /app/node_modules/.bun
# Copy manifest files for dependency installation (in case L2 is stale)
COPY services/billing/billing-api/package.json ./package.json
COPY services/billing/billing-api/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY services/billing/billing-api/.autogenerated/.npmrc.docker.autogenerated ./.npmrc
COPY services/billing/billing-api/.autogenerated/tsconfig.docker.autogenerated.json ./tsconfig.json
COPY services/billing/billing-api/.autogenerated/tsconfig.autogenerated.json ./.autogenerated/tsconfig.autogenerated.json
COPY services/billing/billing-api/.autogenerated/*.ts ./.autogenerated/
COPY services/billing/billing-api/src ./src
COPY services/billing/billing-api/prisma ./prisma
RUN bunx prisma generate
# Normalize Prisma output for both import styles using shared script
COPY shared-platform-engineering/docker-templates/prisma-normalize-client.sh /usr/local/bin/prisma-normalize-client.sh
RUN chmod +x /usr/local/bin/prisma-normalize-client.sh && PRISMA_EXPORT_GENERATED_CLIENT=1 /usr/local/bin/prisma-normalize-client.sh
ENV NODE_ENV=production
RUN bun run build
# Fix hono/cors subpath import for Bun runtime compatibility
RUN find ./dist -type f -name "*.js" -exec sed -i "s|from 'hono/cors'|from '../node_modules/hono/dist/middleware/cors/index.js'|g" {} + || true


# ---- L3: migration_engine ----
FROM tdk-saas-starter-l3-migrator:latest AS l3_migration_build
WORKDIR /app/services/billing/billing-api
# Copy manifest files for dependency installation
COPY services/billing/billing-api/package.json ./package.json
COPY services/billing/billing-api/prisma ./prisma
COPY services/billing/billing-api/.autogenerated/.npmrc.docker.autogenerated .npmrc
COPY services/billing/billing-api/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY bun.lock* ./
# Install runtime deps only for migrator image (skip test/dev toolchain)
# NOTE: keep bunfig.toml (it carries the @beauty-crm/@tdk-landscape registry
# scopes pointing at Verdaccio) - deleting it forces scoped packages to fall
# back to the public npm registry and fail with ConnectionRefused/404.
RUN --mount=type=cache,target=/cache/bun,sharing=shared rm -f bun.lock bun.lockb && env -u CI BUN_CONFIG_FROZEN_LOCKFILE=false BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-install bun install --production --no-frozen-lockfile --concurrent-scripts --cache-dir=/cache/bun
# Prisma CLI is often in devDependencies; install it explicitly without mutating manifest files
RUN --mount=type=cache,target=/cache/bun,sharing=shared PRISMA_VERSION=$(sed -n 's/.*"prisma"[[:space:]]*:[[:space:]]*"[~^]*\([^"]*\)".*/\1/p' package.json | head -n 1) && [ -n "$PRISMA_VERSION" ] && BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-install bun add --no-save --exact prisma@"$PRISMA_VERSION" --cache-dir=/cache/bun
# Generate Prisma client and normalize output location for runtime compatibility
RUN bunx prisma generate
# Normalize Prisma output for both import styles using shared script
COPY shared-platform-engineering/docker-templates/prisma-normalize-client.sh /usr/local/bin/prisma-normalize-client.sh
RUN chmod +x /usr/local/bin/prisma-normalize-client.sh && PRISMA_EXPORT_GENERATED_CLIENT=0 /usr/local/bin/prisma-normalize-client.sh
RUN mkdir -p node_modules/prisma/node_modules
RUN test -f prisma/schema.prisma


# ---- L3: production_purger ----
FROM tdk-saas-starter-l2:latest AS l3_production_purger
WORKDIR /app/services/billing/billing-api
COPY services/billing/billing-api/package.json ./package.json
COPY services/billing/billing-api/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY services/billing/billing-api/.autogenerated/.npmrc.docker.autogenerated ./.npmrc
RUN --mount=type=cache,target=/cache/bun,sharing=shared bun install --production --cache-dir=/cache/bun
# Option 2: Aggressive node_modules pruning to reduce size
# NOTE: Keep .d.ts files - they are needed for Bun module resolution with subpath exports
RUN find node_modules -type f \( -name '*.md' -o -name '*.ts' ! -name '*.d.ts' -o -name '*.map' -o -name '*.test.js' -o -name '*.spec.js' -o -name 'README*' -o -name 'CHANGELOG*' -o -name 'LICENSE*' \) -delete
RUN find node_modules -type d \( -name '.bin' -o -name 'test' -o -name 'tests' -o -name '__tests__' -o -name 'spec' -o -name 'specs' -o -name '.github' -o -name 'docs' -o -name 'examples' \) -exec rm -rf {} + 2>/dev/null || true


# ---- L4: backend_runtime ----
FROM tdk-saas-starter-l4-backend:latest AS l4_backend_runtime
WORKDIR /app/services/billing/billing-api
# Build argument to skip Infisical setup (for local dev / fast builds)
ARG SKIP_INFISICAL_SETUP=0
ENV NODE_ENV=production
COPY --from=l3_production_purger /app/services/billing/billing-api/node_modules ./node_modules
COPY --from=l3_production_purger /app/services/billing/billing-api/node_modules/.bun /app/node_modules/.bun
COPY --from=l3_backend_build /app/services/billing/billing-api/node_modules/.prisma ./node_modules/.prisma
COPY --from=l3_backend_build /app/services/billing/billing-api/prisma ./prisma
COPY --from=l3_backend_build /app/services/billing/billing-api/dist ./dist
COPY services/billing/billing-api/package.json ./package.json
# Fix Bun module resolution: .prisma/client must be reachable from .bun/ linker paths
USER root
COPY shared-platform-engineering/docker-templates/prisma-bun-client-link-fix.sh /usr/local/bin/prisma-bun-client-link-fix.sh
RUN chmod +x /usr/local/bin/prisma-bun-client-link-fix.sh && /usr/local/bin/prisma-bun-client-link-fix.sh
USER bun
# Fix Bun hoisted package symlinks that break when copied to Docker
USER root
COPY shared-platform-engineering/docker-templates/bun-hoisted-symlink-fix.sh /usr/local/bin/bun-hoisted-symlink-fix.sh
RUN chmod +x /usr/local/bin/bun-hoisted-symlink-fix.sh && /usr/local/bin/bun-hoisted-symlink-fix.sh
USER bun
COPY services/billing/billing-api/.autogenerated/prisma.config.autogenerated.ts ./prisma.config.ts
EXPOSE 4000
COPY --chmod=0755 shared-platform-engineering/docker-templates/infisical-entrypoint.sh /entrypoint.sh
ENV RESOURCE_NAME="billing-api"
ENV INFISICAL_SECRET_PATH="/services/billing-api"
ENV INFISICAL_TOKEN=${INFISICAL_TOKEN:-}
ENV INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID:-}
ENV INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET:-}
ENV INFISICAL_API_URL=${INFISICAL_API_URL:-http://infisical:8080}
ENV INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID:-}
ENV INFISICAL_ENVIRONMENT=${INFISICAL_ENVIRONMENT:-dev}
ENV INFISICAL_ALLOW_FALLBACK=${INFISICAL_ALLOW_FALLBACK:-true}
ENV RESOURCE_NAME=billing-api
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bun", "run", "start"]

FROM l4_backend_runtime AS production
FROM l4_backend_runtime AS development


